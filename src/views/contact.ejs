<%- include('partials/header', { title }) %>
<h1>Contact us</h1>

<% if (sent) { %>
  <p class="success">Thanks! Your message has been received.</p>
<% } %>

<form class="contact-form" method="post" action="/contact" novalidate>
  <label>Name
    <input type="text" name="name" value="<%= values.name || '' %>">
    <% if (errors.name) { %><span class="error"><%= errors.name %></span><% } %>
  </label>
  <label>Email
    <input type="email" name="email" value="<%= values.email || '' %>">
    <% if (errors.email) { %><span class="error"><%= errors.email %></span><% } %>
  </label>
  <label>Message
    <textarea name="message" rows="5"><%= values.message || '' %></textarea>
    <% if (errors.message) { %><span class="error"><%= errors.message %></span><% } %>
  </label>
  <button class="btn" type="submit">Send</button>
</form>
<%- include('partials/footer') %>
