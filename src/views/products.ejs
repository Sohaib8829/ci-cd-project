<%- include('partials/header', { title }) %>
<h1>Products</h1>

<form class="filters" method="get" action="/products">
  <input type="text" name="q" placeholder="Search..." value="<%= q %>">
  <select name="category">
    <option value="">All categories</option>
    <% categories.forEach(function (c) { %>
      <option value="<%= c %>" <%= c === category ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>
  <button class="btn" type="submit">Filter</button>
</form>

<% if (products.length === 0) { %>
  <p class="empty">No products found.</p>
<% } else { %>
  <div class="grid">
    <% products.forEach(function (p) { %>
      <article class="card">
        <h3><%= p.name %></h3>
        <p class="category"><%= p.category %></p>
        <p class="price"><%= p.price %></p>
        <span class="badge <%= p.inStock ? 'ok' : 'out' %>"><%= p.inStock ? 'In stock' : 'Out of stock' %></span>
      </article>
    <% }) %>
  </div>
<% } %>
<%- include('partials/footer') %>
